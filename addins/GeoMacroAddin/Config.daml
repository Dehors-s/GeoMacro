<ArcGIS xmlns="http://schemas.esri.com/DADF/Registry"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd"
        defaultAssembly="GeoMacroAddin.dll"
        defaultNamespace="GeoMacroAddin">
  <AddInInfo id="{3E1E5BE5-6E0C-4B50-8E6E-5D5D4E3B7A90}"
             version="0.1.5"
             desktopVersion="3.0.0">
    <Name>GeoMacro Add-in</Name>
    <Description>GeoMacro MVP — batch ArcPy script generation from geoprocessing history.</Description>
    <Author>GeoMacro Team</Author>
    <Company>GeoMacro</Company>
    <Date>2026-04-25</Date>
    <Subject>Geoprocessing</Subject>
  </AddInInfo>
  <modules>
    <insertModule id="GeoMacroAddin_Module"
                  className="GeoMacroAddinModule"
                  autoLoad="true"
                  caption="GeoMacro Add-in">

      <tabs>
        <tab id="GeoMacroAddin_Tab"
             caption="GeoMacro"
             keytip="G">
          <group refID="GeoMacroAddin_Group" />
        </tab>
      </tabs>

      <groups>
        <group id="GeoMacroAddin_Group"
               caption="Pipeline"
               keytip="P">
          <button refID="GeoMacroAddin_ShowGeoMacroPanel" size="large" />
          <button refID="GeoMacroAddin_ShowEventLogDockpane" size="small" />
          <button refID="GeoMacroAddin_ToggleCapture" size="small" />
        </group>
      </groups>

      <controls>
        <!-- Main panel button -->
        <button id="GeoMacroAddin_ShowGeoMacroPanel"
                caption="GeoMacro Pipeline"
                className="Commands.ShowGeoMacroPanelButton"
                keytip="G"
                loadOnClick="true" />
        <!-- Legacy event log -->
        <button id="GeoMacroAddin_ShowEventLogDockpane"
                caption="Event Log"
                className="Commands.ShowEventLogDockpaneButton"
                keytip="L"
                loadOnClick="true" />
        <!-- Capture toggle -->
        <button id="GeoMacroAddin_ToggleCapture"
                caption="Toggle Capture"
                className="Commands.ToggleCaptureButton"
                keytip="T"
                loadOnClick="true" />
      </controls>

      <dockPanes>
        <!-- New GeoMacro Pipeline Panel -->
        <dockPane id="GeoMacroAddin_GeoMacroPanel"
                  caption="GeoMacro Pipeline"
                  className="Dockpane.GeoMacroPanelViewModel"
                  dock="group">
          <content className="Dockpane.GeoMacroPanelView" />
        </dockPane>
        <!-- Legacy event log -->
        <dockPane id="GeoMacroAddin_EventLogDockpane"
                  caption="GeoMacro Event Log"
                  className="Dockpane.EventLogDockpaneViewModel"
                  dock="group">
          <content className="Dockpane.EventLogDockpaneView" />
        </dockPane>
      </dockPanes>
    </insertModule>
  </modules>
</ArcGIS>
